[Unit]
Description=Canvas LMS background jobs (delayed_job)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment=RAILS_ENV=production
Environment=RBENV_ROOT=__INSTALL_DIR__/.rbenv
Environment=PATH=__INSTALL_DIR__/.rbenv/shims:__INSTALL_DIR__/.rbenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Keep temp files in the app's own canvas-owned tmp/, not shared /tmp (see the
# canvas-web unit for why).
Environment=TMPDIR=__INSTALL_DIR__/tmp
ExecStart=__INSTALL_DIR__/.rbenv/shims/bundle exec script/delayed_job run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
