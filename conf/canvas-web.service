[Unit]
Description=Canvas LMS web server (Puma)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment=RAILS_ENV=production
Environment=RBENV_ROOT=__INSTALL_DIR__/.rbenv
Environment=PATH=__INSTALL_DIR__/.rbenv/shims:__INSTALL_DIR__/.rbenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__INSTALL_DIR__/.rbenv/shims/bundle exec puma -e production -b tcp://127.0.0.1:__PORT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
