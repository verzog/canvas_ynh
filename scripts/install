#!/bin/bash

#=================================================
# GENERIC START
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STAGE 1 — SOURCE, SYSTEM DEPS, DATABASE, REDIS
#=================================================
# apt packages (incl. redis-server) and the PostgreSQL database are provisioned
# automatically by the [resources] block in manifest.toml before this script runs.

# Clones the pinned Canvas tag into $install_dir (see _common.sh for why we clone
# rather than use a checksummed tarball).
fetch_canvas_source

# Rails secrets used by security.yml. encryption_key must be >= 20 chars; each
# jwt_encryption_keys entry must be exactly 64 chars (Canvas raises "jwt encryption
# key required" and 500s the dashboard otherwise).
encryption_key=$(ynh_string_random --length=40)
ynh_app_setting_set --key=encryption_key --value="$encryption_key"
jwt_encryption_key=$(ynh_string_random --length=64)
ynh_app_setting_set --key=jwt_encryption_key --value="$jwt_encryption_key"

# Allocate a dedicated, empty Redis logical database for Canvas (config/redis.yml).
# Canvas caches its entire Setting hash — including encryption_key_hash — in Redis
# under the "all_settings" key. Sharing the default DB 0 lets a previous install's
# cached hash survive (Redis is a persistent system service that install/rollback
# never flush) and mismatch this install's freshly generated encryption_key, which
# aborts db:initial_setup with "encryption key is incorrect". A freshly allocated DB
# is empty, so there is no stale hash to collide with.
redis_db=$(ynh_redis_get_free_db)
ynh_app_setting_set --key=redis_db --value="$redis_db"

# Install Node.js (Canvas engines: node >= 20) and Yarn classic.
ynh_script_progression "Installing Node.js and Yarn..."
ynh_nodejs_install
ynh_hide_warnings npm install --global yarn@1.19.1

#=================================================
# STAGE 2 — RUBY 3.4 + GEM DEPENDENCIES
#=================================================
# NOTE: build_ruby + bundle install is the highest-risk part. Validate on a live
# YunoHost 12.x (Trixie) box before trusting this end to end.

build_ruby

ynh_script_progression "Installing Ruby gem dependencies (bundle install)..."
pushd "$install_dir" >/dev/null
    ruby_exec gem install bundler
    # Production only: skip development/test gem groups.
    ruby_exec bundle config set --local without 'development test'
    ruby_exec bundle config set --local path "$install_dir/vendor/bundle"
    ruby_exec bundle install --jobs=4
popd >/dev/null

ynh_script_progression "Installing JavaScript dependencies (yarn install)..."
pushd "$install_dir" >/dev/null
    ruby_exec yarn install --pure-lockfile
popd >/dev/null

#=================================================
# STAGE 3 — CANVAS CONFIGURATION FILES
#=================================================

ynh_script_progression "Configuring Canvas..."

# Each of these templates lives in ../conf/ and is filled from install settings.
ynh_config_add --template="database.yml"      --destination="$install_dir/config/database.yml"
ynh_config_add --template="security.yml"      --destination="$install_dir/config/security.yml"
ynh_config_add --template="domain.yml"        --destination="$install_dir/config/domain.yml"
ynh_config_add --template="outgoing_mail.yml" --destination="$install_dir/config/outgoing_mail.yml"
ynh_config_add --template="redis.yml"         --destination="$install_dir/config/redis.yml"
ynh_config_add --template="cache_store.yml"   --destination="$install_dir/config/cache_store.yml"
# Required by the canvas-jobs worker (inst-jobs); the web server does not read it.
ynh_config_add --template="delayed_jobs.yml"  --destination="$install_dir/config/delayed_jobs.yml"

#=================================================
# STAGE 4 — ASSETS, THEN DATABASE SCHEMA + FIRST ADMIN
#=================================================
# Assets MUST be compiled before db:initial_setup: some migrations regenerate
# brand CSS and need the gulp-rev asset manifest to already exist.
compile_assets

ynh_script_progression "Initialising the Canvas database (schema + first admin)..."
# db:initial_setup is normally interactive; these env vars drive it non-interactively.
pushd "$install_dir" >/dev/null
    env RBENV_ROOT="$rbenv_root" \
        PATH="$rbenv_root/shims:$rbenv_root/bin:$PATH" \
        RAILS_ENV=production \
        CANVAS_LMS_ADMIN_EMAIL="$admin_email" \
        CANVAS_LMS_ADMIN_PASSWORD="$password" \
        CANVAS_LMS_ACCOUNT_NAME="$app" \
        CANVAS_LMS_STATS_COLLECTION="opt_out" \
        bundle exec rake db:initial_setup
popd >/dev/null

# The build steps above ran as root and created root-owned files (vendor/bundle,
# node_modules, public/dist, tmp, log). The services run as "$app", so hand the
# whole tree back to that user or Puma/jobs can't write their cache/logs/tmp.
chown -R "$app:www-data" "$install_dir"

#=================================================
# STAGE 5 — SYSTEM SERVICES (WEB + JOBS) + NGINX
#=================================================

ynh_script_progression "Configuring system services..."
# Two long-running services: the Puma web server and the delayed_job worker.
ynh_config_add_systemd --service="$app-web"  --template="canvas-web.service"
ynh_config_add_systemd --service="$app-jobs" --template="canvas-jobs.service"

yunohost service add "$app-web"  --description="Canvas LMS web server" --log="$install_dir/log/production.log"
yunohost service add "$app-jobs" --description="Canvas LMS background jobs" --log="$install_dir/log/delayed_job.log"

ynh_script_progression "Configuring NGINX web server..."
ynh_config_add_nginx

#=================================================
# START SERVICES
#=================================================

ynh_script_progression "Starting Canvas services..."
# Puma prints "Listening on" to stdout -> journald, so wait on the journal.
ynh_systemctl --service="$app-web"  --action="start" --wait_until="Listening on" --log_path="systemd"
ynh_systemctl --service="$app-jobs" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of Canvas LMS completed"
