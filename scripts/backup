#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# DECLARE DATA AND CONF FILES TO BACK UP
#=================================================

ynh_print_info "Declaring files to be backed up..."

# App code, vendored gems, built assets and rbenv Ruby (large — see README).
ynh_backup "$install_dir"

# Uploaded files and generated exports. ynh_backup auto-detects $data_dir as data.
ynh_backup "$data_dir"

# System integration.
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app-web.service"
ynh_backup "/etc/systemd/system/$app-jobs.service"

#=================================================
# BACK UP THE POSTGRESQL DATABASE
#=================================================

ynh_print_info "Backing up the PostgreSQL database..."
ynh_psql_dump_db > db.sql

ynh_print_info "Backup script completed. Run 'yunohost backup create' to make a backup."
